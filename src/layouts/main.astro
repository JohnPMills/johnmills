---
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import SquareLines from "../components/square-lines.astro";
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description || "Default description if none provided"} />

    <!-- Immediately apply dark mode from localStorage to prevent flicker -->
    <script is:inline>
      if (typeof Storage !== 'undefined') {
        if (localStorage.getItem('dark_mode') === 'true') {
          document.documentElement.classList.add('dark');
        }
      }
    </script>

    <!-- Analytics -->
    <script data-collect-dnt="true" async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
    <noscript>
      <img src="https://queue.simpleanalyticscdn.com/noscript.gif?collect-dnt=true" alt="" referrerpolicy="no-referrer-when-downgrade"/>
    </noscript>

    <style>
      .prose img {
        border-radius: 20px;
      }
    </style>
    <link rel="icon" type="image/x-icon" href="../assets/images/favicon.png" />
    <script src="../assets/css/main.css"></script>
    <Fragment set:html={import.meta.env.HEADER_INJECT} />
  </head>
  <body class="antialiased bg-white dark:bg-neutral-950">
    <SquareLines />
    <Header />
    <slot />
    <Footer />

    <!-- Main JS -->
    <script is:inline>
      // Safe dark toggle listener
      const toggle = document.getElementById('darkToggle');
      if (toggle) {
        toggle.addEventListener('click', () => {
          const isDark = document.documentElement.classList.contains('dark');
          if (isDark) {
            document.documentElement.classList.remove('dark');
            localStorage.removeItem('dark_mode');
            if (typeof showDay === 'function') showDay(true);
          } else {
            document.documentElement.classList.add('dark');
            localStorage.setItem('dark_mode', 'true');
            if (typeof showNight === 'function') showNight(true);
          }
        });
      }

      // Optional: ensure toggle works on page load
      window.addEventListener('DOMContentLoaded', () => {
        if (localStorage.getItem('dark_mode') === 'true') {
          document.documentElement.classList.add('dark');
        }
      });
    </script>

    <script src="../assets/js/main.js"></script>
    <Fragment set:html={import.meta.env.FOOTER_INJECT} />
  </body>
</html>
